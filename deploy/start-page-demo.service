[Unit]
Description=Start page guest demo (separate layout, no weather)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jeff
Group=jeff
WorkingDirectory=/srv/shared/python/start_page
# ufw allows port 5056 in on tailscale0 only, so the LAN can't reach this copy.
Environment=HOST=0.0.0.0
Environment=PORT=5056
# Its own layout, in /var/lib/start-page-demo (created by StateDirectory below).
Environment=START_PAGE_DATA=/var/lib/start-page-demo
StateDirectory=start-page-demo
# Health light from Uptime Kuma. Guests come in over Tailscale, so they get the
# KUMA_LINK_TAILNET link (kuma-tailnet.socket relays port 3001; the tailnet policy
# must allow autogroup:shared tcp:3001). No ambient.json, so weather is "not configured".
Environment=KUMA_URL=http://192.168.5.25:3001
Environment=KUMA_LINK=http://ha.lan:3001/status/home
Environment=KUMA_LINK_TAILNET=http://{host}:3001/status/home
Environment=XDG_CACHE_HOME=/var/cache/start-page-demo
CacheDirectory=start-page-demo
ExecStart=/srv/shared/python/start_page/.venv/bin/python app.py
Restart=on-failure
RestartSec=5

# Sandboxing, as in start-page.service, plus: the owner's data/ folder (layout, notes,
# weather keys) is invisible to this copy.
InaccessiblePaths=/srv/shared/python/start_page/data
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
MemoryMax=384M

[Install]
WantedBy=multi-user.target
